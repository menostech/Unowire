# Production environment variables for Docker Compose.
# Copy this file to .env.docker and fill in real values before deploying:
#   cp .env.docker.example .env.docker
# .env.docker is gitignored — never commit real secrets.

# PostgreSQL password for the unowire user. Use a strong random string.
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# JWT signing secret. Use a random string >= 32 chars.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG

# Initial admin account credentials.
ADMIN_EMAIL=admin@unowire.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Debug mode — keep false in production.
DEBUG=false
